<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Skill Registry" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-dark bg-dark mb-4">
      <div class="container">
        <a class="navbar-brand fw-bold" href="<%= root_path %>">Skill Registry</a>
        <div class="d-flex gap-2">
          <%= link_to "All Skills", root_path, class: "btn btn-outline-light btn-sm" %>
          <%= link_to "Conflicts", conflicts_path, class: "btn btn-outline-warning btn-sm" %>
          <%= link_to "+ New Skill", new_skill_path, class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </nav>

    <main class="container">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Bootstrap 5 JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
